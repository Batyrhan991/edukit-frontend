{
  "openapi": "3.1.1",
  "info": {
    "title": "EduKit.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/system/info": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Версия API и состояние серверных флагов модулей.",
        "operationId": "GetSystemInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Регистрация учителя по email. Ответ одинаковый для нового и существующего email.",
        "operationId": "RegisterTeacher",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterTeacherRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "VerifyEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/verify-email/resend": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "ResendVerificationEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Вход по email (или логину ученика) и паролю. Ставит HttpOnly cookie сессии.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/password-reset/request": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "RequestPasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "ConfirmPasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Активные входы текущего пользователя.",
        "operationId": "ListSessions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}": {
      "delete": {
        "tags": [
          "Account"
        ],
        "summary": "Завершить свой вход. Чужая или несуществующая сессия — 404.",
        "operationId": "RevokeSession",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/providers": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Какие способы входа включены на сервере (кнопка Google показывается только при настроенном ключе).",
        "operationId": "GetAuthProviders",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google/start": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Перенаправляет на страницу входа Google. Открывается переходом браузера, не fetch.",
        "operationId": "StartGoogleSignIn",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "next",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remember",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/account/sign-in-methods": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Способы входа текущего пользователя: пароль, Google.",
        "operationId": "GetSignInMethods",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInMethodsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/google/link": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Подключить Google к своему аккаунту: перенаправление на страницу Google. Открывается переходом браузера.",
        "operationId": "StartGoogleLink",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/account/google": {
      "delete": {
        "tags": [
          "Account"
        ],
        "summary": "Отключить Google. Нельзя, если у аккаунта нет пароля (иначе не останется способа войти).",
        "operationId": "UnlinkGoogle",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/credits": {
      "get": {
        "tags": [
          "Generators"
        ],
        "summary": "Баланс кредитов и цены операций — показываются до запуска генерации.",
        "operationId": "GetCredits",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditBalanceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/generators/ksp": {
      "post": {
        "tags": [
          "Generators"
        ],
        "summary": "Запустить генерацию КСП. Заголовок Idempotency-Key обязателен: повтор с тем же ключом не списывает кредиты повторно.",
        "operationId": "GenerateKsp",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KspRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/generations": {
      "get": {
        "tags": [
          "Generators"
        ],
        "summary": "История генераций за 30 дней.",
        "operationId": "ListGenerations",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GenerationListItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/generations/{id}": {
      "get": {
        "tags": [
          "Generators"
        ],
        "operationId": "GetGeneration",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/generations/{id}/cancel": {
      "post": {
        "tags": [
          "Generators"
        ],
        "operationId": "CancelGeneration",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/mfa/verify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Второй шаг входа: код из приложения или резервный код. Выдаёт новую cookie сессии.",
        "operationId": "VerifyMfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/mfa": {
      "get": {
        "tags": [
          "Account"
        ],
        "operationId": "GetMfaStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/mfa/setup": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Новый ключ для приложения-аутентификатора. Включается только после подтверждения кодом.",
        "operationId": "BeginMfaSetup",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaSetupResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/mfa/enable": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Подтверждение кодом и включение. Возвращает резервные коды один раз.",
        "operationId": "EnableMfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/mfa/recovery-codes": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Новые резервные коды (старые перестают работать). Нужна сессия, прошедшая второй фактор.",
        "operationId": "RegenerateRecoveryCodes",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/mfa/disable": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Отключение по текущему коду. Для администраторов запрещено.",
        "operationId": "DisableMfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/admin/overview": {
      "get": {
        "tags": [
          "Admin"
        ],
        "operationId": "GetAdminOverview",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOverviewResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/feature-flags/{key}": {
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Включить или выключить модуль. identity, admin, реальные платежи и Kundelik через API не меняются.",
        "operationId": "SetFeatureFlag",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeatureFlagUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/admin/audit": {
      "get": {
        "tags": [
          "Admin"
        ],
        "operationId": "GetAuditLog",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEntryResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminOverviewResponse": {
        "required": [
          "usersTotal",
          "staff",
          "platformAdmins",
          "usersWithMfa",
          "features"
        ],
        "type": "object",
        "properties": {
          "usersTotal": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "staff": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "platformAdmins": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "usersWithMfa": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        }
      },
      "AuditEntryResponse": {
        "required": [
          "id",
          "occurredAt",
          "actorId",
          "action",
          "targetType",
          "targetId",
          "succeeded",
          "metadata"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "targetType": {
            "type": [
              "null",
              "string"
            ]
          },
          "targetId": {
            "type": [
              "null",
              "string"
            ]
          },
          "succeeded": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "AuthProvidersResponse": {
        "required": [
          "google"
        ],
        "type": "object",
        "properties": {
          "google": {
            "type": "boolean"
          }
        }
      },
      "CreditBalanceResponse": {
        "required": [
          "balance",
          "reserved",
          "plan",
          "monthlyGrant",
          "cycleEnd",
          "prices",
          "testValues"
        ],
        "type": "object",
        "properties": {
          "balance": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reserved": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "plan": {
            "type": "string"
          },
          "monthlyGrant": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "cycleEnd": {
            "type": "string",
            "format": "date-time"
          },
          "prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditOperationPrice"
            }
          },
          "testValues": {
            "type": "boolean"
          }
        }
      },
      "CreditOperationPrice": {
        "required": [
          "tool",
          "credits"
        ],
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "credits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "FeatureFlagUpdateRequest": {
        "required": [
          "enabled"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
