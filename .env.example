# Пример переменных окружения EduKit frontend. Скопируйте в .env.local (не коммитится).
# Адрес EduKit API; используется только на сервере Next.js, в браузер не попадает.
EDUKIT_API_URL=http://localhost:5080

# true — только если сайт работает за собственным балансировщиком, который перезаписывает X-Forwarded-For (ADR-0025)
EDUKIT_TRUST_UPSTREAM_PROXY=false
